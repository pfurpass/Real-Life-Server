# Copy to .env and fill in real values before running `docker compose up`.
# See docs/CONCEPT.md, chapter 10 (Sicherheit) and chapter 15 (Betriebs-Runbook).

# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# JWT signing secret - at least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change_me_at_least_32_characters_long

# AES-256 master key for encrypting destination stream keys at rest - must be exactly 32 bytes,
# base64-encoded. Generate with: openssl rand -base64 32
# IMPORTANT: the value below is a placeholder and NOT valid Base64 (it contains underscores) -
# the app deliberately refuses to start with it. You must replace it with real generated output.
KEY_PROTECTION_MASTER_KEY=change_me_base64_32_bytes

# Shared secret sent on the runOnReady/runOnNotReady webhook callbacks (mediamtx.yml). Not used
# by the synchronous auth gate (authHTTPAddress), which MediaMTX calls with no configurable
# headers - see docs/CONCEPT.md chapter 10. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change_me_webhook_shared_secret

# Optional: Discord webhook URL for scene-change notifications (chapter "Discord Webhook
# Benachrichtigungen"). Leave empty to disable.
DISCORD_WEBHOOK_URL=

# Public origin the frontend is served from (used for CORS).
PUBLIC_ORIGIN=https://stream.example.com
